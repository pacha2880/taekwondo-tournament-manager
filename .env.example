DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Solo en producción (Render). Con esto, la app no arranca si SECRET_KEY o
# ADMIN_PASSWORD siguen con su valor por defecto. En local, dejarlo sin definir.
# APP_ENV=production
# Orígenes (separados por comas) autorizados a llamar a la API desde un navegador, p. ej. el frontend
# de otro equipo. Sin definir, no se permite ninguno. En producción no admite "*".
# CORS_ORIGINS=https://mi-frontend.example,http://localhost:5173

# Para scripts/reset_data.py y scripts/seed_demo_api.py con dev o prod: se copian de las variables de entorno
# de cada servicio en Render (Environment). La app no las lee.
DEV_DATABASE_URL=
DEV_ADMIN_USERNAME=
DEV_ADMIN_PASSWORD=
PROD_DATABASE_URL=
PROD_ADMIN_USERNAME=
PROD_ADMIN_PASSWORD=
