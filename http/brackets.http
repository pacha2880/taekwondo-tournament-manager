@baseUrl = http://localhost:8000/api/v1

### Dependencias: club + torneo + categoria
# @name createClub
POST {{baseUrl}}/clubs
Content-Type: application/json

{
  "name": "Dojang Brackets {{$guid}}"
}

###
# @name createTournament
POST {{baseUrl}}/tournaments
Content-Type: application/json

{
  "name": "Copa de Prueba",
  "date": "2026-11-15",
  "location": "San Salvador"
}

###
# @name createCategory
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "tournament_id": {{createTournament.response.body.$.id}},
  "gender": "male",
  "age_label": "Cadete",
  "min_age": 12,
  "max_age": 14,
  "belt_group": "color",
  "weight_label": "Hasta 45kg"
}

### Cinco atletas inscritos (impar, para ver byes en accion: size=8, 3 byes)
# @name createAthlete1
POST {{baseUrl}}/athletes
Content-Type: application/json

{
  "name": "Atleta Uno",
  "birth_date": "2012-01-01",
  "gender": "male",
  "belt_rank": "verde",
  "weight_kg": 40,
  "club_id": {{createClub.response.body.$.id}}
}

